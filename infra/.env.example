# Skopiuj do infra/.env (plik .env nie trafia do repozytorium).
# Wartości poniżej są tylko do rozwoju lokalnego – przed wystawieniem na serwer zmień je wszystkie.

POSTGRES_USER=truckmaps
POSTGRES_PASSWORD=truckmaps_dev
POSTGRES_DB=truckmaps

# Zitadel. Masterkey: dokładnie 32 znaki; nie zmieniaj po pierwszym starcie (szyfruje dane).
ZITADEL_MASTERKEY=TruckMapsDevMasterkey32Chars0000
LOGIN_SESSION_COOKIE_SECRET=TruckMapsDevLoginCookieSecret32Chars
# Administrator konsoli: http://localhost:8080/ui/console, login: admin@truckmaps.localhost
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=TruckMaps-Dev-2026!

# Testowe konto kierowcy (rejestracja przez http://localhost:8000 → „Załóż konto”).
# Nie jest tworzone automatycznie; to tylko zapis danych użytych w testach ręcznych.
TEST_DRIVER_EMAIL=kierowca.test@truckmaps.localhost
TEST_DRIVER_PASSWORD=Kierowca-Test-2026!

# Valhalla buduje trasy z plików *.osm.pbf w infra/data/valhalla (infra/download_map.ps1).
# Opcjonalnie kontener może sam pobrać mapy – kilka adresów oddzielonych spacją:
# VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/poland-latest.osm.pbf https://download.geofabrik.de/europe/germany-latest.osm.pbf
VALHALLA_THREADS=4
